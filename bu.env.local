# B. uniformis (BU_ATCC8492) demo with variant track — copy to .env.local:
#   cp bu.env.local .env.local
#
# Uses local public/sample-data (FASTA, GFF, VCF). METT FTP has assembly/GFF only;
# sample VCF is built from PMC12222025 curation rows (see scripts/build-bu-sample-vcf.mjs).

VITE_ASSEMBLY_NAME=BU_ATCC8492VPI0062_NT5002.1

VITE_FASTA_GZ_URL=/sample-data/fasta_files/BU_ATCC8492VPI0062_NT5002.1/BU_ATCC8492VPI0062_NT5002.1.fa.gz
VITE_FASTA_FAI_URL=/sample-data/fasta_files/BU_ATCC8492VPI0062_NT5002.1/BU_ATCC8492VPI0062_NT5002.1.fa.gz.fai
VITE_FASTA_GZI_URL=/sample-data/fasta_files/BU_ATCC8492VPI0062_NT5002.1/BU_ATCC8492VPI0062_NT5002.1.fa.gz.gzi

VITE_GFF_BGZ_URL=/sample-data/gff3_files/BU_ATCC8492/BU_ATCC8492_annotations.gff.gz
VITE_GFF_CSI_URL=/sample-data/gff3_files/BU_ATCC8492/BU_ATCC8492_annotations.gff.gz.csi
VITE_GFF_IX_URL=/sample-data/gff3_files/BU_ATCC8492/trix/BU_ATCC8492_annotations.gff.gz.ix
VITE_GFF_IXX_URL=/sample-data/gff3_files/BU_ATCC8492/trix/BU_ATCC8492_annotations.gff.gz.ixx
VITE_GFF_META_URL=/sample-data/gff3_files/BU_ATCC8492/trix/BU_ATCC8492_annotations.gff.gz_meta.json

VITE_ESSENTIALITY_CSV_URL=/sample-data/essentiality/essentiality_sample.csv

VITE_VCF_GZ_URL=/sample-data/variants/BU_ATCC8492/PMC12222025_variants.vcf.gz
VITE_VCF_TBI_URL=/sample-data/variants/BU_ATCC8492/PMC12222025_variants.vcf.gz.tbi
# peg.962 SNP cluster (~9 SNPs in ~2 kb) + flanking genes (~18 kb view)
VITE_INITIAL_LOCATION=contig_1:1198000..1216000
